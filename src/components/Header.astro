---
import { site } from "../data/site";

const links = [
  { href: "#sobre-mi", label: "Sobre mí" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#contacto", label: "Contacto" },
];
---

<header class="header">
  <nav class="container header__nav" aria-label="Principal">
    <a href="#inicio" class="header__brand">{site.name.split(" ")[0]}<span>.dev</span></a>
    <ul class="header__links">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4rem;
  }
  .header__brand {
    font-weight: 800;
    color: var(--text);
    text-decoration: none;
  }
  .header__brand span {
    color: var(--accent);
    font-family: var(--mono);
    font-weight: 400;
  }
  .header__links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .header__links a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .header__links a:hover {
    color: var(--text);
  }
  @media (max-width: 480px) {
    .header__links {
      gap: 0.85rem;
    }
    .header__links a {
      font-size: 0.875rem;
    }
  }
</style>
