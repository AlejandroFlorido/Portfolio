---
import { site } from "../data/site";
---

<section id="sobre-mi" class="section">
  <div class="container about">
    <div>
      <h2 class="section__title">Sobre mí</h2>
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <aside class="about__skills" aria-label="Tecnologías">
      <h3>Tecnologías</h3>
      <ul>
        {site.skills.map((skill) => <li class="tag">{skill}</li>)}
      </ul>
    </aside>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  .about p {
    color: var(--muted);
    max-width: 40rem;
  }
  .about__skills {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .about__skills h3 {
    font-size: 1rem;
  }
  .about__skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  @media (max-width: 720px) {
    .about {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
