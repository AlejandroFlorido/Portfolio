---
import { site } from "../data/site";
---

<section id="contacto" class="section">
  <div class="container contact">
    <h2 class="section__title">Contacto</h2>
    <p>¿Tenés una propuesta, una idea o simplemente querés charlar? Escribime.</p>
    <a class="button button--primary" href={`mailto:${site.email}`}>{site.email}</a>
    <ul class="contact__socials">
      {
        site.socials.map((social) => (
          <li>
            <a href={social.url} target="_blank" rel="noopener">
              {social.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact p {
    color: var(--muted);
    margin: 0 0 1.5rem;
  }
  .contact .button {
    overflow-wrap: anywhere;
  }
  .contact__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }
  .contact__socials a {
    font-weight: 600;
    text-decoration: none;
  }
</style>
