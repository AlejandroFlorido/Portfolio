---
import Layout from "../layouts/Layout.astro";
import { nodes } from "../data/nodes";

const base = import.meta.env.BASE_URL;
---

<Layout>
  <canvas id="topo" aria-hidden="true"></canvas>
  <div class="vignette" aria-hidden="true"></div>

  <div class="hud" aria-hidden="true">
    <span class="hud__corner hud__corner--tl"></span>
    <span class="hud__corner hud__corner--tr"></span>
    <span class="hud__corner hud__corner--bl"></span>
    <span class="hud__corner hud__corner--br"></span>
    <span class="hud__status">Núcleo · <b data-status>en reposo</b></span>
    <span class="hud__clock" data-clock>--:--:--</span>
    <span class="hud__name">A. Florido</span>
  </div>

  <button class="sound-toggle" type="button" aria-pressed="true" data-sound>
    <span class="sound-toggle__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <span data-sound-label>Sonido</span>
  </button>

  <p class="copyright" data-copyright>
    © {new Date().getFullYear()} Alejandro Florido<span class="copyright__rest"> · Todos los derechos reservados</span>
  </p>

  <main class="stage">
    <svg class="links" aria-hidden="true">
      {nodes.map((node) => <line data-link={node.id} />)}
      {nodes.map((node) => <circle class="packet" r="2.5" data-packet={node.id} />)}
    </svg>

    <button class="core" type="button" aria-label="Activar núcleo" aria-expanded="false" data-core>
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <defs>
          <radialGradient id="coreGlow">
            <stop offset="0%" stop-color="#50dcff" stop-opacity="0.55"></stop>
            <stop offset="100%" stop-color="#50dcff" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle class="core__glow" cx="100" cy="100" r="100"></circle>
        <circle class="core__ring core__ring--outer" cx="100" cy="100" r="96"></circle>
        <circle class="core__ring core__ring--ticks" cx="100" cy="100" r="80"></circle>
        <circle class="core__ring core__ring--arc" cx="100" cy="100" r="64"></circle>
        <circle class="core__heart" cx="100" cy="100" r="26"></circle>
      </svg>
      <span class="globe globe--core" aria-hidden="true">
        <span class="globe__spin"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
      </span>
      <span class="core__wave" aria-hidden="true"></span>
      <span class="core__wave core__wave--late" aria-hidden="true"></span>
    </button>
    <p class="hint">Tocá el núcleo para iniciar</p>

    <nav aria-label="Secciones">
      {
        nodes.map((node, i) => (
          <button class="node" type="button" data-node={node.id} style={`--delay: ${0.15 + i * 0.09}s`}>
            <span class="node__dot">
              <span class="globe" aria-hidden="true">
                <span class="globe__spin"><i /><i /><i /><i /><i /></span>
              </span>
            </span>
            <span class="node__label">{node.label}</span>
            <span class="node__code">{node.code}</span>
          </button>
        ))
      }
    </nav>
  </main>

  <aside class="panel" aria-live="polite" aria-labelledby="panel-title" data-panel>
    <!-- Anillos en 3D: la sensación de estar dentro del nodo -->
    <div class="panel__orb" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="panel__inner">
      <div class="panel__head">
        <div>
          <p class="panel__code" data-panel-code></p>
          <h2 class="panel__title" id="panel-title" data-panel-title></h2>
        </div>
      </div>
      <div class="panel__body" data-panel-body></div>
    </div>
  </aside>

  <span class="closer__link" aria-hidden="true" data-closer-link></span>
  <button class="closer" type="button" aria-label="Cerrar sección" data-panel-close>
    <span class="closer__dot" aria-hidden="true"></span>
    <span class="closer__label">Cerrar</span>
  </button>

  {
    nodes.map((node) => (
      <template data-content={node.id}>
        <Fragment set:html={node.html.replaceAll('href="cv-', `href="${base}cv-`)} />
      </template>
    ))
  }

  <script>
    import { startTopo } from "../scripts/topo";
    import { sfx } from "../scripts/sound";
    import { nodes } from "../data/nodes";
    import { createCrew, type Pt } from "../scripts/cursors";
    import { createCloser } from "../scripts/closer";
    import { createKeeper } from "../scripts/keeper";
    import { createPanelCrew } from "../scripts/panel-crew";

    const topo = startTopo(document.getElementById("topo") as HTMLCanvasElement);
    const body = document.body;
    const stage = document.querySelector<HTMLElement>(".stage")!;
    const core = document.querySelector<HTMLButtonElement>("[data-core]")!;
    const status = document.querySelector<HTMLElement>("[data-status]")!;
    const clock = document.querySelector<HTMLElement>("[data-clock]")!;
    const panelTitle = document.querySelector<HTMLElement>("[data-panel-title]")!;
    const panelCode = document.querySelector<HTMLElement>("[data-panel-code]")!;
    const panelBody = document.querySelector<HTMLElement>("[data-panel-body]")!;
    const panel = document.querySelector<HTMLElement>("[data-panel]")!;
    const soundBtn = document.querySelector<HTMLButtonElement>("[data-sound]")!;
    const nodeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-node]")];
    const links = [...document.querySelectorAll<SVGLineElement>("[data-link]")];
    const packets = [...document.querySelectorAll<SVGCircleElement>("[data-packet]")];
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ONLINE = `en línea · ${nodes.length} nodos`;

    // ---------- Reloj ----------
    const tick = () => (clock.textContent = new Date().toLocaleTimeString("es-AR", { hour12: false }));
    tick();
    setInterval(tick, 1000);

    // ---------- Sonido ----------
    function renderSound() {
      soundBtn.setAttribute("aria-pressed", String(sfx.enabled));
      soundBtn.classList.toggle("is-off", !sfx.enabled);
      soundBtn.querySelector("[data-sound-label]")!.textContent = sfx.enabled ? "Sonido" : "Silencio";
    }
    renderSound();
    soundBtn.addEventListener("click", () => {
      sfx.setEnabled(!sfx.enabled, body.classList.contains("is-awake"));
      renderSound();
    });

    // ---------- Texto con efecto de tipeo ----------
    let typing = 0;
    function typeInto(el: HTMLElement, text: string, speed = 28, withSound = false) {
      return new Promise<void>((resolve) => {
        if (el === status) clearInterval(typing);
        let i = 0;
        el.textContent = "";
        const id = window.setInterval(() => {
          el.textContent = text.slice(0, ++i);
          if (withSound && i % 2 === 0) sfx.type();
          if (i >= text.length) {
            clearInterval(id);
            resolve();
          }
        }, speed);
        if (el === status) typing = id;
      });
    }
    const setStatus = (text: string) => typeInto(status, text);

    // ---------- Geometría de nodos y conexiones ----------
    interface Seg { x1: number; y1: number; x2: number; y2: number }
    const segs: Seg[] = [];
    const targets: Pt[] = [];

    // Conexión desde el borde del núcleo hasta un nodo en la posición relativa (x, y)
    function segFor(x: number, y: number): Seg | null {
      const c = { x: innerWidth / 2, y: innerHeight / 2 };
      const dist = Math.hypot(x, y);
      const inner = core.offsetWidth / 2 + 6;
      if (dist < inner + 34) return null;
      const ux = x / dist, uy = y / dist;
      return { x1: c.x + ux * inner, y1: c.y + uy * inner, x2: c.x + x - ux * 30, y2: c.y + y - uy * 30 };
    }

    function drawLine(i: number, seg: Seg) {
      const line = links[i];
      line.setAttribute("x1", String(seg.x1));
      line.setAttribute("y1", String(seg.y1));
      line.setAttribute("x2", String(seg.x2));
      line.setAttribute("y2", String(seg.y2));
    }

    function layout() {
      const w = innerWidth, h = innerHeight;
      // Elipse: en pantallas verticales los nodos se separan más en altura
      const rx = Math.min(w * 0.36, h * 0.33);
      const ry = w < h ? Math.min(h * 0.27, w * 0.6) : Math.min(h * 0.3, w * 0.33);
      nodeButtons.forEach((btn, i) => {
        const angle = -Math.PI / 2 + (i / nodeButtons.length) * Math.PI * 2;
        const x = Math.cos(angle) * rx;
        const y = Math.sin(angle) * ry;
        btn.style.setProperty("--x", `${x}px`);
        btn.style.setProperty("--y", `${y}px`);
        targets[i] = { x, y };
        const seg = segFor(x, y)!;
        segs[i] = seg;
        if (!links[i].classList.contains("is-dragging")) drawLine(i, seg);
      });
    }
    layout();
    addEventListener("resize", layout);

    // ---------- Paquetes de datos que viajan por las conexiones ----------
    const packetState = packets.map((_, i) => ({ t: Math.random(), speed: 0.25 + Math.random() * 0.25, burst: 0, i }));
    let last = performance.now();
    function animatePackets(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      packetState.forEach((p) => {
        const seg = segs[p.i];
        const el = packets[p.i];
        if (!seg || !body.classList.contains("is-awake") || !links[p.i].classList.contains("is-placed")) {
          el.style.opacity = "0";
          return;
        }
        const speed = p.burst > 0 ? 2.6 : p.speed;
        p.t += dt * speed;
        if (p.t > 1) {
          p.t = p.burst > 0 ? 1 : 0;
          if (p.burst > 0) p.burst = 0;
        }
        el.setAttribute("cx", String(seg.x1 + (seg.x2 - seg.x1) * p.t));
        el.setAttribute("cy", String(seg.y1 + (seg.y2 - seg.y1) * p.t));
        el.setAttribute("r", p.burst > 0 ? "4.5" : "2.5");
        el.style.opacity = String(Math.sin(Math.PI * p.t));
      });
      requestAnimationFrame(animatePackets);
    }
    if (!reduceMotion) requestAnimationFrame(animatePackets);

    function firePacket(i: number) {
      packetState[i].t = 0;
      packetState[i].burst = 1;
    }

    // ---------- Inclinación 3D: nodos y núcleo miran hacia el mouse ----------
    let tiltFrame = 0;
    addEventListener("pointermove", (e) => {
      if (tiltFrame) return;
      tiltFrame = requestAnimationFrame(() => {
        tiltFrame = 0;
        const root = document.documentElement.style;
        root.setProperty("--mx", ((e.clientX / innerWidth) * 2 - 1).toFixed(3));
        root.setProperty("--my", ((e.clientY / innerHeight) * 2 - 1).toFixed(3));
      });
    });

    // ---------- Punteros que arman la interfaz ----------
    const crew = createCrew({
      stage,
      core,
      nodes: nodeButtons,
      codes: nodes.map((n) => n.code),
      target: (i) => targets[i],
      reduceMotion: false, // los punteros se muestran siempre (ver versión liviana en hud.css)
      segment: (i) => segs[i],
      link(i, p) {
        const line = links[i];
        const seg = segs[i];
        line.classList.toggle("is-placed", p === 1);
        line.classList.toggle("is-dragging", p !== null && p < 1);
        if (p === null) return;
        drawLine(i, {
          x1: seg.x1,
          y1: seg.y1,
          x2: seg.x1 + (seg.x2 - seg.x1) * p,
          y2: seg.y1 + (seg.y2 - seg.y1) * p,
        });
      },
    });

    // ---------- Nodo rojo para cerrar, con sus punteros rojos ----------
    const closer = createCloser({
      panel,
      button: document.querySelector<HTMLElement>("[data-panel-close]")!,
      link: document.querySelector<HTMLElement>("[data-closer-link]")!,
      core,
      prey: crew,
      avoid: () => keeper.position(),
      reduceMotion: false, // los punteros se muestran siempre (ver versión liviana en hud.css)
    });

    // ---------- Punteros azules que arman la pantalla de cada sección ----------
    const panelCrew = createPanelCrew({
      panel,
      code: panelCode,
      title: panelTitle,
      body: panelBody,
      reduceMotion: false, // los punteros se muestran siempre (ver versión liviana en hud.css)
    });
    panelCrew.reset();
    closer.roamCore();

    // ---------- Puntero amarillo: pone el copyright al pie, esquivando a los rojos ----------
    const keeper = createKeeper({
      footer: document.querySelector<HTMLElement>("[data-copyright]")!,
      core,
      asleep: () => !body.classList.contains("is-awake") && !body.classList.contains("is-booting"),
      nodes: nodeButtons,
      patrolling: () =>
        body.classList.contains("is-awake") && !body.classList.contains("is-building") && !body.classList.contains("has-panel"),
    });

    // ---------- Estados ----------
    let bootTimer = 0;

    async function wake() {
      closer.leave();
      body.classList.add("is-building");
      body.classList.add("is-booting");
      core.setAttribute("aria-expanded", "true");
      core.setAttribute("aria-label", "Núcleo activo. Volver a reposo");
      sfx.wake();
      topo.pulse(innerWidth / 2, innerHeight / 2, 1.4);
      topo.setIntensity(1);
      clearTimeout(bootTimer);
      bootTimer = window.setTimeout(() => {
        body.classList.add("is-awake");
        body.classList.remove("is-booting");
      }, reduceMotion ? 0 : 900);
      await setStatus("inicializando núcleo…");
      const built = crew.build();
      await setStatus("agentes armando interfaz…");
      await built;
      body.classList.remove("is-building");
      if (body.classList.contains("is-awake")) setStatus(ONLINE);
    }

    async function sleep() {
      await closePanel(false);
      clearTimeout(bootTimer);
      body.classList.remove("is-awake", "is-booting");
      core.setAttribute("aria-expanded", "false");
      core.setAttribute("aria-label", "Activar núcleo");
      sfx.sleep();
      topo.setIntensity(0.35);
      body.classList.add("is-building");
      setStatus("desarmando interfaz…");
      await crew.unbuild();
      body.classList.remove("is-building");
      setStatus("en reposo");
      if (!body.classList.contains("is-awake")) closer.roamCore();
    }

    let openTimer = 0;
    let openTurn = 0;
    function openPanel(id: string) {
      const index = nodes.findIndex((n) => n.id === id);
      const node = nodes[index];
      const tpl = document.querySelector<HTMLTemplateElement>(`template[data-content="${id}"]`);
      if (!node || !tpl || closing) return;
      sfx.open();
      firePacket(index);
      nodeButtons.forEach((b) => b.classList.toggle("is-active", b.dataset.node === id));
      links.forEach((l) => l.classList.toggle("is-active", l.dataset.link === id));
      const rect = nodeButtons[index].getBoundingClientRect();
      topo.pulse(rect.left + rect.width / 2, rect.top + rect.height / 2, 0.6);
      setStatus(`abriendo ${node.label.toLowerCase()}…`);
      clearTimeout(openTimer);
      const turn = ++openTurn;
      openTimer = window.setTimeout(async () => {
        const fresh = !body.classList.contains("has-panel");
        panelCode.textContent = `${node.code} // acceso concedido`;
        panelBody.replaceChildren(tpl.content.cloneNode(true));
        panelTitle.textContent = "";
        if (fresh) {
          // El nodo se amplía desde donde está: la pantalla sale de él y el
          // escenario se acerca a ese nodo, como si entráramos en él
          const cx = rect.left + rect.width / 2;
          const cy = rect.top + rect.height / 2;
          panel.style.setProperty("--fx", `${cx - innerWidth / 2}px`);
          panel.style.setProperty("--fy", `${cy - innerHeight / 2}px`);
          stage.style.transformOrigin = `${cx}px ${cy}px`;
        }
        panelCrew.prepare(fresh);
        panel.classList.remove("is-scanning");
        void panel.offsetWidth; // reinicia la animación de escaneo
        panel.classList.add("is-scanning");
        body.classList.add("has-panel");
        history.replaceState(null, "", `#${id}`);
        // Pantalla nueva: los azules dibujan el marco y después aparece el nodo rojo
        if (fresh) {
          if (!(await panelCrew.frameIn()) || turn !== openTurn || closing) return;
          closer.build();
        }
        await panelCrew.fill(() => typeInto(panelTitle, node.label, 45, true));
        if (turn === openTurn && !closing && body.classList.contains("has-panel")) setStatus(`nodo ${node.code} · activo`);
      }, reduceMotion ? 0 : 260);
    }

    let closing = false;
    async function closePanel(withSound = true) {
      clearTimeout(openTimer);
      if (!body.classList.contains("has-panel") || closing) return;
      closing = true;
      if (withSound) sfx.close();
      setStatus("cerrando sección…");
      openTurn++;
      // Los rojos desarman el nodo de cerrar mientras los azules borran la pantalla;
      // al final el marco se pliega y recién ahí se cierra la sección
      await Promise.all([closer.unbuild(), panelCrew.clear()]);
      await panelCrew.collapse();
      closing = false;
      body.classList.remove("has-panel");
      nodeButtons.forEach((b) => b.classList.remove("is-active"));
      links.forEach((l) => l.classList.remove("is-active"));
      setStatus(ONLINE);
      history.replaceState(null, "", location.pathname);
    }

    // ---------- Eventos ----------
    core.addEventListener("click", () => {
      if (body.classList.contains("is-booting") || body.classList.contains("is-building") || closing) return;
      if (!body.classList.contains("is-awake")) wake();
      else if (body.classList.contains("has-panel")) closePanel();
      else sleep();
    });
    nodeButtons.forEach((btn, i) => {
      btn.addEventListener("click", () => openPanel(btn.dataset.node!));
      const enter = () => {
        if (!body.classList.contains("is-awake")) return;
        links[i].classList.add("is-hover");
        sfx.hover();
      };
      const leave = () => links[i].classList.remove("is-hover");
      btn.addEventListener("pointerenter", enter);
      btn.addEventListener("focus", enter);
      btn.addEventListener("pointerleave", leave);
      btn.addEventListener("blur", leave);
    });
    document.querySelector("[data-panel-close]")!.addEventListener("click", () => closePanel());
    addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePanel();
    });

    // Si la URL trae una sección (#proyectos), abrir directamente
    const initial = location.hash.slice(1);
    if (nodes.some((n) => n.id === initial)) {
      wake().then(() => openPanel(initial));
    }
  </script>
</Layout>
